# Cornerstone environment variables
# Copy this file to .env.local for local development.
# Never commit real secrets.

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server-only service role key
# Keep this server-side only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database connection strings
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# AI provider configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# App environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEMO_MODE=true

# Production safety notes
# In production:
# - NEXT_PUBLIC_APP_ENV should be production
# - NEXT_PUBLIC_DEMO_MODE should be false
# - demo role switching must be disabled
# - API auth must use Supabase server-side session/JWT checks
